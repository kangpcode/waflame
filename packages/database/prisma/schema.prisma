generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. Multi-Tenant, Users & RBAC
// -------------------------------------------------------------

model Tenant {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  name                String    @db.VarChar(150)
  slug                String    @unique @db.VarChar(100)
  status              String    @default("ACTIVE") @db.VarChar(30) // ACTIVE, SUSPENDED, EXPIRED
  maxDevices          Int       @default(1) @map("max_devices")
  maxContacts         Int       @default(500) @map("max_contacts")
  maxMessagesPerMonth Int       @default(1000) @map("max_messages_per_month")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  tenantUsers   TenantUser[]
  roles         Role[]
  subscriptions Subscription[]
  invoices      Invoice[]
  devices       Device[]
  contacts      Contact[]
  contactGroups ContactGroup[]
  contactTags   ContactTag[]
  conversations Conversation[]
  messages      Message[]
  templates     Template[]
  campaigns     Campaign[]
  autoReplies   AutoReply[]
  webhooks      Webhook[]
  webhookLogs   WebhookLog[]
  apiKeys       ApiKey[]
  imports       Import[]
  waGroups      WaGroup[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model User {
  id                String    @id @default(uuid()) @db.VarChar(36)
  email             String    @unique @db.VarChar(191)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  fullName          String    @map("full_name") @db.VarChar(150)
  phoneNumber       String?   @map("phone_number") @db.VarChar(30)
  avatarUrl         String?   @map("avatar_url") @db.VarChar(255)
  isSuperadmin      Boolean   @default(false) @map("is_superadmin")
  isActive          Boolean   @default(true) @map("is_active")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret   String?   @map("two_factor_secret") @db.VarChar(255)
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  tenantUsers   TenantUser[]
  conversations Conversation[] @relation("AssignedAgent")
  auditLogs     AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String?  @map("tenant_id") @db.VarChar(36)
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  tenantUsers     TenantUser[]

  @@unique([tenantId, slug])
  @@index([tenantId, slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.VarChar(36)
  permissionId String @map("permission_id") @db.VarChar(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model TenantUser {
  id        String    @id @default(uuid()) @db.VarChar(36)
  tenantId  String    @map("tenant_id") @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  roleId    String    @map("role_id") @db.VarChar(36)
  isOwner   Boolean   @default(false) @map("is_owner")
  status    String    @default("ACTIVE") @db.VarChar(30) // INVITED, ACTIVE, SUSPENDED
  invitedAt DateTime? @map("invited_at")
  joinedAt  DateTime? @default(now()) @map("joined_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@map("tenant_users")
}

// -------------------------------------------------------------
// 2. Billing & Subscriptions
// -------------------------------------------------------------

model Plan {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  name                 String   @db.VarChar(100)
  slug                 String   @unique @db.VarChar(50)
  description          String?  @db.Text
  price                Decimal  @db.Decimal(14, 2)
  billingCycle         String   @default("MONTHLY") @map("billing_cycle") @db.VarChar(20) // MONTHLY, YEARLY
  maxDevices           Int      @map("max_devices")
  maxContacts          Int      @map("max_contacts")
  maxCampaignsPerMonth Int      @map("max_campaigns_per_month")
  maxMessagesPerMonth  Int      @map("max_messages_per_month")
  features             Json
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String    @id @default(uuid()) @db.VarChar(36)
  tenantId          String    @map("tenant_id") @db.VarChar(36)
  planId            String    @map("plan_id") @db.VarChar(36)
  status            String    @default("ACTIVE") @db.VarChar(30) // ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id             String    @id @default(uuid()) @db.VarChar(36)
  tenantId       String    @map("tenant_id") @db.VarChar(36)
  subscriptionId String?   @map("subscription_id") @db.VarChar(36)
  invoiceNumber  String    @unique @map("invoice_number") @db.VarChar(50)
  amount         Decimal   @db.Decimal(14, 2)
  status         String    @default("UNPAID") @db.VarChar(30) // UNPAID, PAID, EXPIRED, REFUNDED
  paymentGateway String?   @map("payment_gateway") @db.VarChar(50) // midtrans, xendit, manual
  transactionId  String?   @map("transaction_id") @db.VarChar(100)
  paymentUrl     String?   @map("payment_url") @db.VarChar(255)
  paidAt         DateTime? @map("paid_at")
  dueDate        DateTime  @map("due_date")
  items          Json
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("invoices")
}

// -------------------------------------------------------------
// 3. Devices & WhatsApp Sessions (MariaDB DB Auth Store)
// -------------------------------------------------------------

model Device {
  id            String    @id @default(uuid()) @db.VarChar(36)
  tenantId      String    @map("tenant_id") @db.VarChar(36)
  name          String    @db.VarChar(100)
  phoneNumber   String?   @map("phone_number") @db.VarChar(30)
  providerType  String    @map("provider_type") @db.VarChar(20) // OFFICIAL, BAILEYS
  status        String    @default("DISCONNECTED") @db.VarChar(30) // DISCONNECTED, CONNECTING, CONNECTED, PAIRING, BANNED
  
  // Official Meta Cloud API Encrypted Credentials
  wabaId        String?   @map("waba_id") @db.Text
  phoneNumberId String?   @map("phone_number_id") @db.Text
  accessToken   String?   @map("access_token") @db.Text

  // Anti-banned configs
  isWarmupMode  Boolean   @default(false) @map("is_warmup_mode")
  dailyLimit    Int       @default(500) @map("daily_limit")
  delayMinMs    Int       @default(3000) @map("delay_min_ms")
  delayMaxMs    Int       @default(8000) @map("delay_max_ms")

  lastConnectedAt DateTime? @map("last_connected_at")
  lastActiveAt    DateTime? @map("last_active_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      WaSession[]
  conversations Conversation[]
  messages      Message[]
  templates     Template[]
  campaigns     Campaign[]
  autoReplies   AutoReply[]
  waGroups      WaGroup[]

  @@map("devices")
}

model WaSession {
  id          BigInt   @id @default(autoincrement())
  deviceId    String   @map("device_id") @db.VarChar(36)
  sessionKey  String   @map("session_key") @db.VarChar(191)
  sessionData String   @map("session_data") @db.LongText
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, sessionKey])
  @@map("wa_sessions")
}

// -------------------------------------------------------------
// 4. Contacts, Groups & Tags
// -------------------------------------------------------------

model Contact {
  id              String    @id @default(uuid()) @db.VarChar(36)
  tenantId        String    @map("tenant_id") @db.VarChar(36)
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String?   @map("last_name") @db.VarChar(100)
  phoneNumber     String    @map("phone_number") @db.VarChar(30)
  email           String?   @db.VarChar(191)
  customFields    Json?     @map("custom_fields")
  isBlacklisted   Boolean   @default(false) @map("is_blacklisted")
  blacklistReason String?   @map("blacklist_reason") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupMembers       ContactGroupMember[]
  tagRelations       ContactTagRelation[]
  conversations      Conversation[]
  campaignRecipients CampaignRecipient[]
  waGroupMembers     WaGroupMember[]

  @@unique([tenantId, phoneNumber, deletedAt])
  @@map("contacts")
}

model ContactGroup {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  color       String   @default("#f97316") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members ContactGroupMember[]

  @@map("contact_groups")
}

model ContactGroupMember {
  contactId      String @map("contact_id") @db.VarChar(36)
  contactGroupId String @map("contact_group_id") @db.VarChar(36)

  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group   ContactGroup @relation(fields: [contactGroupId], references: [id], onDelete: Cascade)

  @@id([contactId, contactGroupId])
  @@map("contact_group_members")
}

model ContactTag {
  id        String   @id @default(uuid()) @db.VarChar(36)
  tenantId  String   @map("tenant_id") @db.VarChar(36)
  name      String   @db.VarChar(50)
  color     String   @default("#ef4444") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relations ContactTagRelation[]

  @@unique([tenantId, name])
  @@map("contact_tags")
}

model ContactTagRelation {
  contactId    String @map("contact_id") @db.VarChar(36)
  contactTagId String @map("contact_tag_id") @db.VarChar(36)

  contact Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     ContactTag @relation(fields: [contactTagId], references: [id], onDelete: Cascade)

  @@id([contactId, contactTagId])
  @@map("contact_tag_relations")
}

// -------------------------------------------------------------
// 5. Conversations & Messages
// -------------------------------------------------------------

model Conversation {
  id              String   @id @default(uuid()) @db.VarChar(36)
  tenantId        String   @map("tenant_id") @db.VarChar(36)
  deviceId        String   @map("device_id") @db.VarChar(36)
  contactId       String?  @map("contact_id") @db.VarChar(36)
  remoteJid       String   @map("remote_jid") @db.VarChar(100)
  status          String   @default("OPEN") @db.VarChar(30) // OPEN, PENDING, RESOLVED
  assignedAgentId String?  @map("assigned_agent_id") @db.VarChar(36)
  lastMessageAt   DateTime @default(now()) @map("last_message_at")
  unreadCount     Int      @default(0) @map("unread_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedAgent User?     @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@index([tenantId, deviceId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                String    @id @default(uuid()) @db.VarChar(36)
  tenantId          String    @map("tenant_id") @db.VarChar(36)
  deviceId          String    @map("device_id") @db.VarChar(36)
  conversationId    String?   @map("conversation_id") @db.VarChar(36)
  direction         String    @db.VarChar(20) // INBOUND, OUTBOUND
  remoteJid         String    @map("remote_jid") @db.VarChar(100)
  messageType       String    @map("message_type") @db.VarChar(30)
  content           String?   @db.Text
  mediaUrl          String?   @map("media_url") @db.VarChar(255)
  mediaType         String?   @map("media_type") @db.VarChar(100)
  status            String    @default("QUEUED") @db.VarChar(30) // QUEUED, SENDING, SENT, DELIVERED, READ, FAILED
  errorCode         String?   @map("error_code") @db.VarChar(50)
  errorMessage      String?   @map("error_message") @db.Text
  externalMessageId String?   @map("external_message_id") @db.VarChar(100)
  idempotencyKey    String?   @map("idempotency_key") @db.VarChar(100)
  metadata          Json?
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  readAt            DateTime? @map("read_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device             Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  conversation       Conversation?       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  campaignRecipients CampaignRecipient[]

  @@unique([tenantId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([externalMessageId])
  @@map("messages")
}

// -------------------------------------------------------------
// 6. Templates & Campaigns
// -------------------------------------------------------------

model Template {
  id              String   @id @default(uuid()) @db.VarChar(36)
  tenantId        String   @map("tenant_id") @db.VarChar(36)
  deviceId        String?  @map("device_id") @db.VarChar(36)
  name            String   @db.VarChar(100)
  category        String   @default("MARKETING") @db.VarChar(50)
  language        String   @default("id") @db.VarChar(20)
  components      Json
  status          String   @default("DRAFT") @db.VarChar(30) // DRAFT, PENDING, APPROVED, REJECTED
  metaTemplateId  String?  @map("meta_template_id") @db.VarChar(100)
  rejectionReason String?  @map("rejection_reason") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device    Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  campaigns Campaign[]

  @@map("templates")
}

model Campaign {
  id              String    @id @default(uuid()) @db.VarChar(36)
  tenantId        String    @map("tenant_id") @db.VarChar(36)
  deviceId        String    @map("device_id") @db.VarChar(36)
  name            String    @db.VarChar(150)
  description     String?   @db.VarChar(255)
  messageType     String    @map("message_type") @db.VarChar(30)
  templateId      String?   @map("template_id") @db.VarChar(36)
  rawMessage      String?   @map("raw_message") @db.Text
  mediaUrl        String?   @map("media_url") @db.VarChar(255)
  scheduledAt     DateTime? @map("scheduled_at")
  status          String    @default("DRAFT") @db.VarChar(30) // DRAFT, SCHEDULED, RUNNING, PAUSED, COMPLETED, CANCELLED
  totalRecipients Int       @default(0) @map("total_recipients")
  sentCount       Int       @default(0) @map("sent_count")
  deliveredCount  Int       @default(0) @map("delivered_count")
  readCount       Int       @default(0) @map("read_count")
  failedCount     Int       @default(0) @map("failed_count")
  minDelaySec     Int       @default(5) @map("min_delay_sec")
  maxDelaySec     Int       @default(15) @map("max_delay_sec")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device     Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  template   Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@map("campaigns")
}

model CampaignRecipient {
  id           BigInt    @id @default(autoincrement())
  campaignId   String    @map("campaign_id") @db.VarChar(36)
  contactId    String?   @map("contact_id") @db.VarChar(36)
  phoneNumber  String    @map("phone_number") @db.VarChar(30)
  status       String    @default("PENDING") @db.VarChar(30) // PENDING, SENT, FAILED, SKIPPED
  errorMessage String?   @map("error_message") @db.VarChar(255)
  sentAt       DateTime? @map("sent_at")
  messageId    String?   @map("message_id") @db.VarChar(36)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// -------------------------------------------------------------
// 7. Auto Replies & Bots
// -------------------------------------------------------------

model AutoReply {
  id              String   @id @default(uuid()) @db.VarChar(36)
  tenantId        String   @map("tenant_id") @db.VarChar(36)
  deviceId        String?  @map("device_id") @db.VarChar(36)
  name            String   @db.VarChar(100)
  triggerType     String   @map("trigger_type") @db.VarChar(30) // EXACT, CONTAINS, REGEX, WELCOME, FALLBACK
  keywords        Json?
  responseType    String   @map("response_type") @db.VarChar(30) // TEXT, MEDIA, TEMPLATE
  responseContent String   @map("response_content") @db.Text
  mediaUrl        String?  @map("media_url") @db.VarChar(255)
  isActive        Boolean  @default(true) @map("is_active")
  scheduleEnabled Boolean  @default(false) @map("schedule_enabled")
  businessHours   Json?    @map("business_hours")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("auto_replies")
}

// -------------------------------------------------------------
// 8. Webhooks, API Keys, Imports & Groups
// -------------------------------------------------------------

model Webhook {
  id        String   @id @default(uuid()) @db.VarChar(36)
  tenantId  String   @map("tenant_id") @db.VarChar(36)
  name      String   @db.VarChar(100)
  url       String   @db.VarChar(255)
  secretKey String   @map("secret_key") @db.VarChar(100)
  events    Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs   WebhookLog[]

  @@map("webhooks")
}

model WebhookLog {
  id              BigInt   @id @default(autoincrement())
  webhookId       String   @map("webhook_id") @db.VarChar(36)
  tenantId        String   @map("tenant_id") @db.VarChar(36)
  event           String   @db.VarChar(50)
  payload         Json
  responseStatus  Int?     @map("response_status")
  responseBody    String?  @map("response_body") @db.Text
  executionTimeMs Int?     @map("execution_time_ms")
  retryCount      Int      @default(0) @map("retry_count")
  status          String   @db.VarChar(20) // SUCCESS, FAILED
  createdAt       DateTime @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
}

model ApiKey {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  tenantId           String    @map("tenant_id") @db.VarChar(36)
  name               String    @db.VarChar(100)
  keyHash            String    @map("key_hash") @db.VarChar(255)
  prefix             String    @db.VarChar(16)
  permissions        Json
  rateLimitPerMinute Int       @default(60) @map("rate_limit_per_minute")
  lastUsedAt         DateTime? @map("last_used_at")
  expiresAt          DateTime? @map("expires_at")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Import {
  id            String   @id @default(uuid()) @db.VarChar(36)
  tenantId      String   @map("tenant_id") @db.VarChar(36)
  fileName      String   @map("file_name") @db.VarChar(255)
  fileUrl       String   @map("file_url") @db.VarChar(255)
  entityType    String   @map("entity_type") @db.VarChar(30) // CONTACTS, GROUP_INVITES
  totalRows     Int      @default(0) @map("total_rows")
  processedRows Int      @default(0) @map("processed_rows")
  successRows   Int      @default(0) @map("success_rows")
  failedRows    Int      @default(0) @map("failed_rows")
  status        String   @default("PENDING") @db.VarChar(30) // PENDING, PROCESSING, COMPLETED, FAILED
  errorLogUrl   String?  @map("error_log_url") @db.VarChar(255)
  mappingConfig Json     @map("mapping_config")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("imports")
}

model WaGroup {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  tenantId            String   @map("tenant_id") @db.VarChar(36)
  deviceId            String   @map("device_id") @db.VarChar(36)
  groupJid            String   @map("group_jid") @db.VarChar(100)
  name                String   @db.VarChar(150)
  description         String?  @db.Text
  inviteLink          String?  @map("invite_link") @db.VarChar(255)
  participantCount    Int      @default(0) @map("participant_count")
  isAnnouncementOnly  Boolean  @default(false) @map("is_announcement_only")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device  Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  members WaGroupMember[]

  @@unique([deviceId, groupJid])
  @@map("wa_groups")
}

model WaGroupMember {
  id            BigInt   @id @default(autoincrement())
  waGroupId     String   @map("wa_group_id") @db.VarChar(36)
  contactId     String?  @map("contact_id") @db.VarChar(36)
  phoneNumber   String   @map("phone_number") @db.VarChar(30)
  isAdmin       Boolean  @default(false) @map("is_admin")
  isSuperadmin  Boolean  @default(false) @map("is_superadmin")
  joinedAt      DateTime @default(now()) @map("joined_at")

  group   WaGroup  @relation(fields: [waGroupId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@map("wa_group_members")
}

// -------------------------------------------------------------
// 9. Audit Logs
// -------------------------------------------------------------

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     String?  @map("tenant_id") @db.VarChar(36)
  userId       String?  @map("user_id") @db.VarChar(36)
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.VarChar(100)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}
