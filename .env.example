# Server Config
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Database & Cache
DATABASE_URL=mysql://root:root@127.0.0.1:3306/waflame
REDIS_URL=redis://127.0.0.1:6379

# JWT & Authentication
JWT_ACCESS_SECRET=waflame-super-secure-jwt-access-secret-32-chars-long!
JWT_REFRESH_SECRET=waflame-super-secure-jwt-refresh-secret-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cryptography (AES-256-GCM 32 bytes hex string)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Superadmin Initial Seeder
SUPERADMIN_EMAIL=admin@waflame.com
SUPERADMIN_PASSWORD=SuperSecretPassword123!
SUPERADMIN_NAME=Waflame Super Admin

# Meta WhatsApp Business Platform (Cloud API)
META_API_VERSION=v21.0
META_APP_SECRET=meta_app_secret_placeholder
META_VERIFY_TOKEN=waflame_meta_verify_token

# Storage / Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=16
